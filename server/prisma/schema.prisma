generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                  @id @default(autoincrement())
  username          String               @unique
  password          String
  bio               String?
  avatarUrl         String?
  messages          Message[]            @relation("SentMessages")
  chats             Chat[]               @relation("UserChats")
  memberships       ChatMembership[]     @relation("UserMemberships")
  createdChats      Chat[]               @relation("ChatCreator")
  pushSubscriptions PushSubscription[]
  blockedUsers      BlockedUser[]        @relation("BlockedByUser")
  blockedByUsers    BlockedUser[]        @relation("BlockedUsers")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  onlineStatus      UserOnlineStatus     @default(ONLINE)
  lastConnection    DateTime             @default(now())
}

enum UserOnlineStatus {
  ONLINE
  OFFLINE
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  ADMIN
  MEMBER
}

enum MessageType {
  USER
  SYSTEM
}

model Chat {
  id          Int              @id @default(autoincrement())
  type        ChatType         @default(DIRECT)
  name        String?
  description String?
  avatarUrl   String?
  createdBy   Int?
  creator     User?            @relation("ChatCreator", fields: [createdBy], references: [id])
  members     User[]           @relation("UserChats")
  memberships ChatMembership[]
  messages    Message[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@map("Chat")
}

model ChatMembership {
  id      Int            @id @default(autoincrement())
  chat    Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId  Int
  user    User           @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
  role    ChatMemberRole @default(MEMBER)
  addedBy Int?
  addedAt DateTime       @default(now())

  @@unique([chatId, userId])
  @@map("chat_memberships")
}

model Message {
  id        Int           @id @default(autoincrement())
  content   String
  type      MessageType   @default(USER)
  chat      Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    Int           @map("chatId")
  sender    User?         @relation("SentMessages", fields: [senderId], references: [id])
  senderId  Int?
  status    MessageStatus @default(SENT)
  metadata  Json?
  createdAt DateTime      @default(now())
  deletedAt DateTime?
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blocker   User     @relation("BlockedByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId Int      @map("blocker_id")
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  endpoint  String   @unique
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}
