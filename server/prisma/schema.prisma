generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                  @id @default(autoincrement())
  username          String               @unique
  password          String
  bio               String?
  avatarUrl         String?
  messages          Message[]            @relation("SentMessages")
  chats             Chat[]               @relation("UserChats")
  pushSubscriptions PushSubscription[]
  blockedUsers      BlockedUser[]        @relation("BlockedByUser")
  blockedByUsers    BlockedUser[]        @relation("BlockedUsers")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  onlineStatus      UserOnlineStatus     @default(ONLINE)
  lastConnection    DateTime             @default(now())
}

enum UserOnlineStatus {
  ONLINE
  OFFLINE
}

model Chat {
  id        Int       @id @default(autoincrement())
  members   User[]    @relation("UserChats")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("Chat")
}

model Message {
  id        Int           @id @default(autoincrement())
  content   String
  chat      Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    Int          @map("chatId")
  sender    User         @relation("SentMessages", fields: [senderId], references: [id])
  senderId  Int
  status    MessageStatus @default(SENT)
  createdAt DateTime     @default(now())
  deletedAt DateTime?
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blocker   User     @relation("BlockedByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId Int      @map("blocker_id")
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  endpoint  String   @unique
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}
